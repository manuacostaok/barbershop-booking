PORT=5000
# ⚠️ OJO con el nombre de la base entre el último "/" y el "?" — sin
# eso, Mongo cae por defecto a una base genérica llamada "test" que
# puede estar compartida con otros proyectos tuyos en el mismo cluster.
# Poné el nombre real de la base de ESTE cliente ahí (ej: /barbershop).
MONGO_URI=mongodb+srv://usuario:password@tu-cluster.mongodb.net/nombre_de_tu_base?retryWrites=true&w=majority
JWT_SECRET=reemplazar_por_un_secreto_largo_y_random_de_al_menos_64_caracteres
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# 📧 EMAIL (confirmaciones de turno) — opcional, si no se completa
# la app funciona igual pero no manda mails. Con Gmail hay que usar
# una "contraseña de aplicación", no la contraseña normal de la cuenta.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="TurnosIA <tu_usuario@gmail.com>"

# 💬 WHATSAPP (recordatorios, plan Premium) — opcional, tiene costo
# por mensaje del proveedor (Twilio/Meta). Sin esto configurado,
# la app funciona igual pero no manda WhatsApp.
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# 💳 MERCADO PAGO — opcional, si no se completa la página /planes
# usa un checkout de demostración. Access Token de tu cuenta de
# https://www.mercadopago.com.ar/developers/panel — OJO: el de
# producción mueve plata real, no lo compartas ni lo subas a git.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# Secreto de firma del webhook (panel de MP > Webhooks > tu app) —
# opcional, si se completa se valida la firma de cada notificación.
MP_WEBHOOK_SECRET=

# 📬 A qué mail te avisamos cuando alguien paga un plan en /planes
# (solo en la instancia de ventas). Usa el EMAIL_* de arriba para
# mandarlo — sin esto, la venta pasa pero no te enterás por mail.
OWNER_NOTIFICATION_EMAIL=
